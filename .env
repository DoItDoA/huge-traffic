# AWS RDS (MySQL) 설정
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password

# 각 서비스별 DB 이름
DB_NAME_ARTICLE=article
DB_NAME_COMMENT=comment
DB_NAME_LIKE=article_like
DB_NAME_VIEW=article_view

# AWS ElastiCache (Redis) 설정
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# AWS MSK (Kafka) 설정
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# 서비스 간 통신 URL (Docker 컨테이너 간 통신)
ARTICLE_SERVICE_URL=http://article-service:9000
COMMENT_SERVICE_URL=http://comment-service:9001
LIKE_SERVICE_URL=http://like-service:9002
VIEW_SERVICE_URL=http://view-service:9003 